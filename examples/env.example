# p2ptun 环境变量配置文件模板 (examples/env.example)
# 可保存为 /etc/p2ptun/config.env 或 ~/.p2ptun/config.env

# -----------------------------------------------------------------------------
# 基础核心配置 (两端必填)
# -----------------------------------------------------------------------------
# 隧道唯一名称 (服务端与客户端两端通用, P2PTUN_NAME / P2PTUN_ID / P2PTUN_PEER 等价)
P2PTUN_NAME=my-tunnel

# 两端配对密钥 (必须完全一致, 具备信令防扫描与传输加密认证双重校验)
P2PTUN_SECRET=your_strong_secret_2026

# -----------------------------------------------------------------------------
# 模式与目标端点配置
# -----------------------------------------------------------------------------
# 服务端 (expose) 需要暴露的本地 TCP 服务端点 (默认 127.0.0.1:22)
P2PTUN_TARGET=127.0.0.1:22

# 客户端 (connect) 在本地监听的 TCP 端口 (默认 127.0.0.1:2222)
P2PTUN_LISTEN=127.0.0.1:2222

# -----------------------------------------------------------------------------
# 传输协议与速率调优
# -----------------------------------------------------------------------------
# 传输协议: hy2 (Hysteria 2 Brutal CC, 默认推荐) | quic (原生 QUIC) | classic (WebRTC SCTP)
P2PTUN_PROTO=hy2

# Hysteria 2 Brutal 拥塞控制目标发包带宽 (Mbps)
# 在恶劣跨国/高丢包弱网下恒定发包不降速, 推荐设为实际物理下行/上行带宽 (如 50, 100, 200)
P2PTUN_BANDWIDTH=100

# -----------------------------------------------------------------------------
# 信令服务器与 STUN/TURN (公共服务, 默认开箱即用)
# -----------------------------------------------------------------------------
# PeerJS 公共信令集群 (逗号分隔, 自动故障转移)
P2PTUN_BROKER=wss://0.peerjs.com,wss://1.peerjs.com

# STUN 穿透服务器列表 (逗号分隔)
P2PTUN_STUN=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302,stun:stun.miwifi.com:3478,stun:stun.qq.com:3478

# 可选 TURN 中继服务器 (格式: user:pass@turn.example.com:3478?transport=udp)
# P2PTUN_TURN=

# 是否强制 TURN 中继 (遇到公司极端对称 NAT / 完全封禁 UDP 时开启)
# P2PTUN_FORCE_RELAY=false

# -----------------------------------------------------------------------------
# 常驻守护与管理面板
# -----------------------------------------------------------------------------
# 是否以守护进程方式后台常驻运行 (true/false)
# P2PTUN_DAEMON=true

# 本地 HTTP 控制面板/状态服务监听地址 (默认留空不开启, 安全无暴露; 如需查看可设 127.0.0.1:18222)
# P2PTUN_STATUS_ADDR=127.0.0.1:18222

# 日志轮转最大体积 (MB)
P2PTUN_LOG_MAX_MB=10

# 服务端最大允许并发连接的客户端数量 (默认 16)
P2PTUN_MAX_PEERS=16
