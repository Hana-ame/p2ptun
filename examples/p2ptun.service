# Example systemd unit for the expose side.
# Adjust User/Group and the env file path, then:
#   sudo install -m 0644 examples/p2ptun.service /etc/systemd/system/p2ptun.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now p2ptun

[Unit]
Description=p2ptun expose (P2P TCP tunnel)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=YOURUSER
Group=YOURGROUP
EnvironmentFile=/etc/p2ptun/env
UnsetEnvironment=http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY socks_proxy SOCKS_PROXY no_proxy NO_PROXY
ExecStart=/usr/local/bin/p2ptun expose
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=yes

[Install]
WantedBy=multi-user.target